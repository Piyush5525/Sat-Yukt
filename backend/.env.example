# Google Gemini API key, used to generate verdicts and explanations.
# Get a free key at https://aistudio.google.com/apikey (no card required to start).
GEMINI_API_KEY=

# Retrieval similarity search uses a local sentence-transformers model
# (paraphrase-multilingual-MiniLM-L12-v2, downloaded automatically on first
# run) — no API key needed.

# Origin allowed by CORS. Must match the frontend's dev/deployed URL exactly.
FRONTEND_URL=http://localhost:5173

# SQLite database file. Swap for a Postgres URL if you outgrow SQLite later.
DATABASE_URL=sqlite:///./sat_yukt.db

# Twilio Auth Token, from the Twilio Console dashboard. Used to verify that
# inbound requests to /whatsapp genuinely came from Twilio, not a spoofed
# request — https://www.twilio.com/docs/usage/webhooks/webhooks-security.
# Leave blank for local testing without signature validation; set it before
# exposing the webhook publicly.
# NOTE: Twilio's free WhatsApp sandbox does not reliably deliver for
# non-US numbers — Green API (below) is the primary WhatsApp integration
# for this project; this route is kept for reference / future upgrade to a
# real Twilio WhatsApp sender.
TWILIO_AUTH_TOKEN=

# Green API credentials (green-api.com) — the primary WhatsApp integration.
# From your instance's dashboard after linking WhatsApp via QR code.
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN_INSTANCE=
